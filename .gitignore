# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code session state
.claude/

# Tailoring evaluation harness outputs (paid runs, local only)
eval/out/

# Local Agent (agent/) — Python worker
/agent/.env
/agent/logs/
/agent/.venv/
/agent/dist/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# ...but the template IS committed (the broad .env* rule above hides it).
!/agent/.env.example
