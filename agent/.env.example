# Jobhuntz Local Agent — copy this file to `.env` and fill it in.
# The real `.env` is git-ignored. NEVER put the Supabase service-role key here —
# the worker only ever needs the publishable (anon) key and a device token.

# Your project's REST URL and publishable (anon) key. Find them in Supabase
# → Project Settings → API. These are the same public values the website uses.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# The one-time device token. Open jobhuntz.app/agent, click "Connect a device",
# and paste the token it shows you here. It is stored only as a hash on the
# server; this is the one copy, so keep it secret.
DEVICE_TOKEN=jhd_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# How often (seconds) to ask the queue for the next job when it is empty. The
# worker backs off from here up to 60s while the queue stays empty.
POLL_SECONDS=10

# Safety switch. "dry_run" forces every job to a dry run — the worker never
# submits for real — even if a job row is set to submit mode. Set it to "off"
# only once the real submit flow exists (Chunk 35+) and you trust it.
MODE_OVERRIDE=dry_run

# Optional: a friendly name for this machine, shown by `jobhuntz-agent check`
# and in the local logs. Defaults to this computer's hostname.
# DEVICE_NAME=My PC
